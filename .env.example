# Copy this file to .env locally and fill credentials there. Never commit .env.
# Start with a cTrader DEMO account. Secrets must remain in the backend environment.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8000/callback
CTRADER_HOST=demo
CTRADER_ENABLED=0
CTRADER_ALLOW_LIVE=0
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ENABLED=0
CTRADER_ALLOW_LIVE=0
# Set this to the Python executable/environment where requirements.txt is installed.
CTRADER_PYTHON=python3
# Optional exact broker symbol overrides (broker names differ).
CTRADER_EURUSD_SYMBOL=EURUSD
CTRADER_USDJPY_SYMBOL=USDJPY
CTRADER_XAUUSD_SYMBOL=XAUUSD
CTRADER_WTI_SYMBOL=XTIUSD
CTRADER_SPX_SYMBOL=US500
CTRADER_BTC_SYMBOL=BTCUSD
CTRADER_USDIDR_SYMBOL=USDIDR
# Optional. Must exactly match a symbol name available in your cTrader account.
CTRADER_SYMBOLS=EURUSD
