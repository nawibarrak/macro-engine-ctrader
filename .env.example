# Copy this file to .env locally and fill credentials there. Never commit .env.
# Start with a cTrader DEMO account.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8000/callback
CTRADER_HOST=demo
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Optional. Must exactly match a symbol name available in your cTrader account.
CTRADER_SYMBOLS=EURUSD
